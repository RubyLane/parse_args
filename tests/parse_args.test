if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::test
}
::tcltest::loadTestedCommands

test parse_args-1.1 {no args, dict mode} -body { #<<<
	parse_args::parse_args {} {} d
	set d
} -cleanup {
	unset -nocomplain d
} -result {}
#>>>
test parse_args-1.2 {no args, vars mode} -body { #<<<
	parse_args::parse_args {} {}
} -result {}
#>>>
test parse_args-2.1 {basic option, dict mode} -body { #<<<
	parse_args::parse_args {-foo bar} {-foo {}} d
	set d
} -cleanup {
	unset -nocomplain d
} -result {foo bar}
#>>>
test parse_args-2.2 {basic option, vars mode} -body { #<<<
	parse_args::parse_args {-foo bar} {-foo {}}
	set foo
} -cleanup {
	unset -nocomplain foo
} -result bar
#>>>
test parse_args-3.2 {option escape} -body { #<<<
	parse_args::parse_args {-foo bar -- -baz quux} {
		-foo	{}
		-bar	{}
		-baz	{-default def}
		a		{}
		b		{}
	}
	list $foo [info exists bar] $baz $a $b
} -cleanup {
	unset -nocomplain foo bar baz a b
} -result {bar 0 def -baz quux}
#>>>
test parse_args-3.3 {default positional arg} -body { #<<<
	parse_args::parse_args {a b} {
		-foo	{}
		first	{}
		second	{-default default_second}
		third	{-default default_third}
	}
	list $first $second $third
} -cleanup {
	unset -nocomplain foo first second third
} -result {a b default_third}
#>>>
test parse_args-4.1 {-all} -body { #<<<
	parse_args::parse_args {-ex first -foo a -iex First -ex second -iex Second -ex third -foo b} {
		-ex		{-all}
		-iex	{-all}
		-foo	{}
	}
	list $ex $iex $foo
} -cleanup {
	unset -nocomplain ex iex foo
} -result {{first second third} {First Second} b}
#>>>
test parse_args-4.2 {-all -multi} -body { #<<<
	parse_args::parse_args {-ascii -dictionary -ascii -increasing -decreasing} {
		-ascii			{-multi -name mode -all}
		-dictionary		{-multi -name mode}
		-increasing		{-multi -name order}
		-decreasing		{-multi -name order -all}
	}
	list $mode $order
} -cleanup {
	unset -nocomplain mode order
} -result {{ascii dictionary ascii} {increasing decreasing}}
#>>>
test parse_args-4.3 {-all} -body { #<<<
	parse_args::parse_args {-foo "hello, multi"} {
		-foo	{-all}
	}
	set foo
} -cleanup {
	unset -nocomplain foo
} -result {{hello, multi}}
#>>>
test parse_args-4.4 {-all, omitted, default} -body { #<<<
	parse_args::parse_args {} {
		-foo	{-all -default {}}
	}
	set foo
} -cleanup {
	unset -nocomplain foo
} -result {}
#>>>
test parse_args-10.1 {reject negative -args} -body { #<<<
	parse_args::parse_args {-foo bar} {
		-foo	{-args -1}
	}
	set foo
} -cleanup {
	unset -nocomplain foo
} -returnCodes error -result {-args cannot be negative}
#>>>
test parse_args-10.2 {-args 0, supplied} -body { #<<<
	parse_args::parse_args {-foo} {
		-foo	{-args 0}
	}
	set foo
} -cleanup {
	unset -nocomplain foo
} -result 1
#>>>
test parse_args-10.3 {-args 0, omitted} -body { #<<<
	parse_args::parse_args {-bar ""} {
		-foo	{-args 0}
		-bar	{}
	}
	set foo
} -cleanup {
	unset -nocomplain foo bar
} -result 0
#>>>
test parse_args-10.4 {-args 3, enough} -body { #<<<
	parse_args::parse_args {-foo a "b c" d e f g h i j} {
		-foo	{-args 3}
		-bar	{}
		p1		{}
		p2		{}
		args	{}
	}
	list $foo $p1 $p2 $args
} -cleanup {
	unset -nocomplain foo bar args
} -result [list [list a "b c" d] e f {g h i j}]
#>>>
test parse_args-10.5 {-args 3, too few} -body { #<<<
	parse_args::parse_args {-foo a "b c"} {
		-foo	{-args 3}
		-bar	{}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -match glob -result *
#>>>
test parse_args-10.6 {-args all, omitted, no default} -body { #<<<
	parse_args::parse_args {-bar ""} {
		-foo	{-args all}
		-bar	{}
	}
	info exists foo
} -cleanup {
	unset -nocomplain foo bar
} -result 0
#>>>
test parse_args-10.7 {-args all, omitted, default} -body { #<<<
	parse_args::parse_args {-bar ""} {
		-foo	{-args all -default {foo bar}}
		-bar	{}
	}
	set foo
} -cleanup {
	unset -nocomplain foo bar
} -result {foo bar}
#>>>
test parse_args-10.8 {-args all, omitted, required} -body { #<<<
	parse_args::parse_args {-bar ""} {
		-foo	{-args all -required}
		-bar	{}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -errorCode {PARSE_ARGS REQUIRED -foo} -result {option -foo is required}
#>>>
test parse_args-10.9 {-args all, 0 supplied, default} -body { #<<<
	parse_args::parse_args {-bar "" -foo} {
		-foo	{-args all -default {foo bar}}
		-bar	{}
	}
	set foo
} -cleanup {
	unset -nocomplain foo bar
} -result {}
#>>>
test parse_args-10.10 {-args all, 1 supplied, default} -body { #<<<
	parse_args::parse_args {-bar "" -foo "hello, world"} {
		-foo	{-args all -default {foo bar}}
		-bar	{}
	}
	set foo
} -cleanup {
	unset -nocomplain foo bar
} -result {{hello, world}}
#>>>
test parse_args-10.11 {-args all, 4 supplied, required} -body { #<<<
	parse_args::parse_args {-bar "" -foo "hello, world" x y z} {
		-foo	{-args all -required}
		-bar	{}
	}
	set foo
} -cleanup {
	unset -nocomplain foo bar
} -result {{hello, world} x y z}
#>>>
test parse_args-10.12 {-args all, 4 supplied, looks like option} -body { #<<<
	parse_args::parse_args {-foo "hello, world" -bar "" z} {
		-foo	{-args all}
		-bar	{}
	}
	list [info exists bar] $foo
} -cleanup {
	unset -nocomplain foo bar
} -result {0 {{hello, world} -bar {} z}}
#>>>
test parse_args-10.13 {-args 3, positional, supplied} -body { #<<<
	parse_args::parse_args {a b c d e} {
		foo			{-required}
		bar			{-args 3 -required}
		baz			{-required}
	}
	list $foo $bar $baz
} -cleanup {
	unset -nocomplain foo bar baz
} -result {a {b c d} e}
#>>>
test parse_args-10.14 {-args 3, positional, omitted, required} -body { #<<<
	parse_args::parse_args {a} {
		foo			{-required}
		bar			{-args 3 -required}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -errorCode {PARSE_ARGS REQUIRED bar} -result {argument bar is required}
#>>>
test parse_args-10.15 {-args 3, positional, omitted, optional} -body { #<<<
	parse_args::parse_args {a} {
		foo			{-required}
		bar			{-args 3}
	}
	list [info exists foo] [info exists bar]
} -cleanup {
	unset -nocomplain foo bar
} -result {1 0}
#>>>
test parse_args-10.16 {-args 3, positional, omitted, default} -body { #<<<
	parse_args::parse_args {a} {
		foo			{-required}
		bar			{-args 3 -default {x y z}}
	}
	list $foo $bar
} -cleanup {
	unset -nocomplain foo bar
} -result {a {x y z}}
#>>>
test parse_args-10.17 {-args 3, positional, insufficient, required} -body { #<<<
	parse_args::parse_args {a b c} {
		foo			{-required}
		bar			{-args 3 -required}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -errorCode {PARSE_ARGS WRONGARGS bar} -result {Expecting 3 arguments for bar}
#>>>
test parse_args-10.18 {-args 3, positional, insufficient, optional} -body { #<<<
	# Under the lookahead consumer, the optional multi-arg positional is
	# skipped because `remaining (2) < arg_count (3) + sum_later_req (0)`,
	# so the trailing args are leftover and reported as "too many".
	parse_args::parse_args {a b c} {
		foo			{-required}
		bar			{-args 3}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -match glob -result {wrong # args*}
#>>>
test parse_args-10.19 {-args 3, positional, insufficient, default} -body { #<<<
	# Same shape but bar has -default; bar still gets skipped (default
	# applied), and the trailing args are leftover.
	parse_args::parse_args {a b c} {
		foo			{-required}
		bar			{-args 3 -default {x y z}}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -match glob -result {wrong # args*}
#>>>
test parse_args-11.1 {invalid setting} -body { #<<<
	parse_args::parse_args {} {
		-foo	{-foo 3}
		-bar	{}
	}
} -cleanup {
	unset -nocomplain foo bar
} -returnCodes error -result {bad setting "-foo": must be -default, -required, -validate, -name, -boolean, -args, -enum, -#, -multi, -alias, -all, or -end}
#>>>
test parse_args-12.1 {-end, -boolean, supplied} -body { #<<<
	parse_args::parse_args {-ex a --args -ex e c d} {
		-ex		{-all -default {}}
		--args	{-name se_args -boolean -end}
		first	{}
		second	{}
		rest	{-args all}
	}
	list $ex $se_args $first $second $rest
} -cleanup {
	unset -nocomplain ex se_args first second rest
} -result {a 1 -ex e {c d}}
#>>>
test parse_args-12.2 {-end, -boolean, omitted} -body { #<<<
	parse_args::parse_args {-ex a -ex e c d} {
		-ex		{-all -default {}}
		--args	{-name se_args -boolean -end}
		first	{}
		second	{}
		rest	{-args all}
	}
	list $ex $se_args $first $second [info exists rest]
} -cleanup {
	unset -nocomplain ex se_args first second rest
} -result {{a e} 0 c d 0}
#>>>
test parse_args-20.1 {no args} -body { #<<<
	parse_args::parse_args
} -returnCodes error -result {wrong # args: should be "parse_args::parse_args args args_spec ?dict?"}
#>>>
test parse_args-30.1 {Doesn't generate string rep when spec has no options} -body { #<<<
	set i	[expr {2-1}]
	parse_args::parse_args [list $i] {
		foo {}
	}
	tcl::unsupported::representation $i
} -cleanup {
	unset -nocomplain i foo
} -match glob -result {value is a int * no string representation}
#>>>
test parse_args-30.2 {String rep avoided when trailing positionals are -required} -body { #<<<
	# n=1 reserves the last slot as positional so the option scan never touches it.
	set i	[expr {2-1}]
	parse_args::parse_args [list $i] {
		-mode	{-default x}
		data	{-required}
	}
	tcl::unsupported::representation $i
} -cleanup {
	unset -nocomplain i data mode
} -match glob -result {value is a int * no string representation}
#>>>
test parse_args-30.3 {String rep avoided when spec has no options} -body { #<<<
	# option_count == 0 → option phase is skipped entirely.
	set i	[expr {2-1}]
	parse_args::parse_args [list $i] {
		foo	{}
	}
	tcl::unsupported::representation $i
} -cleanup {
	unset -nocomplain i foo
} -match glob -result {value is a int * no string representation}
#>>>
test parse_args-30.4 {Looks-like-option arg in reserved positional slot} -body { #<<<
	# `-mode` would otherwise match the option, but n=1 forces the trailing slot
	# to be positional regardless of leading '-'.
	parse_args::parse_args {-mode} {
		-mode	{-default x}
		data	{-required}
	}
	set data
} -cleanup {
	unset -nocomplain data mode
} -result -mode
#>>>
test parse_args-40.1 {namespace import} -body { #<<<
	set interp	[interp create]
	$interp eval {
		load {} Parse_args
		namespace import ::parse_args::*
		parse_args {-foo foo-parse_args-40.1} {
			-foo	{-default x}
		}
		set foo
	}
} -cleanup {
	interp delete $interp
	unset -nocomplain interp
} -result foo-parse_args-40.1
#>>>
test parse_args-50.1 {-boolean rejected on positional} -body { #<<<
	parse_args::parse_args {} {
		flag	{-boolean}
	}
} -cleanup {
	unset -nocomplain flag
} -returnCodes error -result {Cannot use -boolean on positional argument "flag"}
#>>>
test parse_args-50.2 {-args 0 rejected on positional} -body { #<<<
	parse_args::parse_args {} {
		zero	{-args 0}
	}
} -cleanup {
	unset -nocomplain zero
} -returnCodes error -result {Cannot use -args 0 on positional argument "zero"}
#>>>
test parse_args-50.3 {Optional positional cannot follow args consumer} -body { #<<<
	parse_args::parse_args {a} {
		args	{}
		trailing	{}
	}
} -returnCodes error -match glob -result {Positional "trailing" cannot follow*}
#>>>
test parse_args-50.4 {Optional positional cannot follow -args all consumer} -body { #<<<
	parse_args::parse_args {a} {
		middle	{-args all}
		trailing	{}
	}
} -returnCodes error -match glob -result {Positional "trailing" cannot follow*}
#>>>
test parse_args-50.5 {Two args/-args all consumers rejected} -body { #<<<
	parse_args::parse_args {a} {
		first	{-args all -required}
		args	{}
	}
} -returnCodes error -match glob -result {Cannot have more than one args/-args all*}
#>>>
test parse_args-51.1 {Lookahead skips optional to reach trailing required (no default)} -body { #<<<
	# arg0 ?arg1? arg2  — `dothing2` from the design discussion
	parse_args::parse_args {a b} {
		arg0	{-required}
		arg1	{}
		arg2	{-required}
	}
	list $arg0 [info exists arg1] $arg2
} -cleanup {
	unset -nocomplain arg0 arg1 arg2
} -result {a 0 b}
#>>>
test parse_args-51.2 {Lookahead applies default for skipped optional} -body { #<<<
	parse_args::parse_args {a b} {
		arg0	{-required}
		arg1	{-default x}
		arg2	{-required}
	}
	list $arg0 $arg1 $arg2
} -cleanup {
	unset -nocomplain arg0 arg1 arg2
} -result {a x b}
#>>>
test parse_args-51.3 {Lookahead consumes optional when room allows} -body { #<<<
	parse_args::parse_args {a b c} {
		arg0	{-required}
		arg1	{-default x}
		arg2	{-required}
	}
	list $arg0 $arg1 $arg2
} -cleanup {
	unset -nocomplain arg0 arg1 arg2
} -result {a b c}
#>>>
test parse_args-51.4 {Lookahead with multi-arg required positional} -body { #<<<
	# ?arg1? arg2.1 arg2.2  — `dothing3`
	parse_args::parse_args {a b} {
		arg1	{}
		arg2	{-required -args 2}
	}
	list [info exists arg1] $arg2
} -cleanup {
	unset -nocomplain arg1 arg2
} -result {0 {a b}}
#>>>
test parse_args-51.5 {args magic with trailing required positional} -body { #<<<
	# args last_arg{-required}  — args reserves space for trailing required.
	parse_args::parse_args {a b c d} {
		args	{-name leading}
		last	{-required}
	}
	list $leading $last
} -cleanup {
	unset -nocomplain leading last
} -result {{a b c} d}
#>>>
test parse_args-51.6 {args magic with empty leading and trailing required} -body { #<<<
	parse_args::parse_args {only} {
		args	{-name leading}
		last	{-required}
	}
	list $leading $last
} -cleanup {
	unset -nocomplain leading last
} -result {{} only}
#>>>
test parse_args-51.7 {-args all positional reserves space for trailing required} -body { #<<<
	parse_args::parse_args {a b c} {
		middle	{-args all}
		tail	{-required}
	}
	list $middle $tail
} -cleanup {
	unset -nocomplain middle tail
} -result {{a b} c}
#>>>
test parse_args-51.8 {dothing4: leading required + optional + trailing required + args tail} -body { #<<<
	parse_args::parse_args {a b} {
		arg0	{-required}
		arg1	{}
		arg2	{-required}
		args	{-name tailargs}
	}
	list $arg0 [info exists arg1] $arg2 $tailargs
} -cleanup {
	unset -nocomplain arg0 arg1 arg2 tailargs
} -result {a 0 b {}}
#>>>
test parse_args-51.9 {dothing4: extra args spill into args} -body { #<<<
	parse_args::parse_args {a b c d e} {
		arg0	{-required}
		arg1	{}
		arg2	{-required}
		args	{-name tailargs}
	}
	list $arg0 $arg1 $arg2 $tailargs
} -cleanup {
	unset -nocomplain arg0 arg1 arg2 tailargs
} -result {a b c {d e}}
#>>>
test parse_args-51.10 {-required + -default treated as optional with default} -body { #<<<
	parse_args::parse_args {} {
		state	{-default normal -required}
	}
	set state
} -cleanup {
	unset -nocomplain state
} -result normal
#>>>

test parse_args-52.1 {Validator re-entering a command using the same spec} -setup { #<<<
	proc reenter args {
		parse_args::parse_args $args {
			-a		{-default adef}
			-b		{-validate {apply {v {if {$v eq "outer"} {reenter -b inner}; return 1}}}}
		}
		list $a $b
	}
} -body {
	# The inner call must not clobber the outer's record of which options were
	# supplied (-a was, so it must keep its value, not get the default)
	reenter -a x -b outer
} -cleanup {
	rename reenter {}
} -result {x outer}
#>>>
test parse_args-52.2 {Validator shimmering the spec obj mid-bind} -setup { #<<<
	set ::spec_52_2 {
		-a	{-validate {apply {v {llength [dict keys $::spec_52_2]; return 1}}}}
		-b	{-default bdef}
		c	{}
	}
	# Make the dict / list shimmer replace the parse_spec intrep: the bind in
	# progress must keep the compiled spec alive
	proc shimmer args {
		parse_args::parse_args $args $::spec_52_2
		list $a $b $c
	}
} -body {
	list [shimmer -a x y] [shimmer -a z w]
} -cleanup {
	rename shimmer {}
	unset -nocomplain ::spec_52_2
} -result {{x bdef y} {z bdef w}}
#>>>
test parse_args-52.3 {Pure list spec (no string rep)} -body { #<<<
	set spec	[list]
	lappend spec -a {-default 1} b {}
	parse_args::parse_args {x} $spec
	list $a $b [string length $spec]
} -cleanup {
	unset -nocomplain spec a b
} -result {1 x 20}
#>>>
test parse_args-52.4 {Load into an interp without $dir (no pkgconfig)} -setup { #<<<
	set child	[interp create]
} -body {
	load {} Parse_args $child
	interp eval $child {
		parse_args::parse_args {x} {a {}}
		list $a [llength [info commands ::parse_args::pkgconfig]]
	}
} -cleanup {
	interp delete $child
	unset -nocomplain child
} -result {x 0}
#>>>
test parse_args-52.5 {Unknown option: message lists the options, errorcode as Tcl_GetIndexFromObj} -body { #<<<
	list \
		[catch {parse_args::parse_args {-y 1} {-x {}}} r o] $r [dict get $o -errorcode] \
		[catch {parse_args::parse_args {-y 1} {-x {} a {} -b {-boolean}}} r] $r \
		[catch {parse_args::parse_args {-y 1} {-x {} -c {-multi -name m} a {} -b {-boolean}}} r] $r
} -cleanup {
	unset -nocomplain r o
} -result [list \
	1 {bad option "-y": must be -x} {TCL LOOKUP INDEX option -y} \
	1 {bad option "-y": must be -x or -b} \
	1 {bad option "-y": must be -x, -c, or -b} \
]
#>>>
test parse_args-52.6 {wrong # args usage is generated from the argspec, without a command name} -setup { #<<<
	set spec {
		-x		{}
		-flag	{-boolean}
		-state	{-enum {normal disabled} -required}
		-pair	{-args 2}
		-a		{-multi -name m}
		-c		{-args all}
		a		{-required}
		b		{}
		p2		{-args 2 -default {}}
	}
	proc foo args {parse_args::parse_args $args $::spec}
} -body {
	list \
		[catch {foo -state normal 1 2 3 4 5} r o] $r [dict get $o -errorcode] \
		[catch {parse_args::parse_args {1 2} {a {}}} r] $r
} -cleanup {
	rename foo {}
	unset -nocomplain spec r o
} -result [list \
	1 {wrong # args: should be "?-x x? ?-flag? -state normal|disabled ?-pair pair pair? ?-a? ?-c c ...? a ?b? ?p2 p2?"} {TCL WRONGARGS} \
	1 {wrong # args: should be "?a?"} \
]
#>>>
test parse_args-52.7 {Duplicate argspec entries are rejected} -body { #<<<
	list \
		[catch {parse_args::parse_args {-x 1} {-x {} -x {-required}}} r] $r \
		[catch {parse_args::parse_args {1 2} {a {} -y {} a {}}} r] $r \
		[catch {parse_args::parse_args {-a} {-a {-multi -name m} -b {-multi -name m}}} r] $r $m
} -cleanup {
	unset -nocomplain r m
} -result [list \
	1 {Duplicate argspec entry "-x"} \
	1 {Duplicate argspec entry "a"} \
	0 {} a \
]
#>>>

# cleanup
::tcltest::cleanupTests
return

# vim: ft=tcl foldmethod=marker foldmarker=<<<,>>> ts=4 shiftwidth=4
